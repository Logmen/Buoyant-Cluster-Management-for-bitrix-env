# =============================================================================
# Ваш слой настроек HAProxy. BCM этот файл НЕ перезаписывает — правки переживут
# и повторный install.sh, и обновление BCM.
#
# Базовый /etc/haproxy/haproxy.cfg генерируется из шаблона: править его смысла
# нет, при следующем прогоне установщика он будет собран заново.
#
# Редактируется через меню BCM: 5 → 9. Меню проверит связку целиком
# (`haproxy -c` по базовому файлу вместе с этим каталогом), разложит файл на все
# LB и перечитает их по очереди — держатель VIP последним, с откатом при ошибке.
#
# ⚠️ Слой ДОПОЛНЯЮЩИЙ, а не переопределяющий. HAProxy запрещает объявлять секцию
# с уже существующим именем: попытка переоткрыть `backend web_backend`, чтобы
# что-то в нём поменять, даст ошибку `duplicate` и конфиг не применится. Отсюда
# правило: здесь ЗАВОДЯТ НОВЫЕ frontend/backend/listen, а параметры уже
# существующих секций (тайминги, состав web-нод, sticky, SSL) меняются через
# cluster.conf и шаблон, а не тут.
#
# ⚠️ Раздел `defaults`, объявленный здесь, действует только на секции, описанные
# НИЖЕ него в этом же файле. На базовые бэкенды он не влияет — их defaults уже
# применён при разборе основного файла.
#
# Файлы каталога читаются по алфавиту; имена с малыми номерами занимает BCM
# (10-mcp.cfg и т.п.), ваш слой — 90-custom.cfg.
# =============================================================================

# Пример: отдельный бэкенд под свой сервис и правило маршрутизации к нему.
# Правило use_backend должно жить в существующем frontend, а его здесь
# переоткрыть нельзя — поэтому маршрутизацию задают через отдельный frontend на
# своём порту либо через cluster.conf.
#
# backend my_service
#     balance roundrobin
#     option httpchk GET /health
#     http-check expect rstatus ^2
#     timeout server 300s
#     server app01 10.0.0.11:8080 check inter 5s fall 3 rise 2
#     server app02 10.0.0.12:8080 check inter 5s fall 3 rise 2
#
# frontend my_service_front
#     bind *:8090
#     default_backend my_service
